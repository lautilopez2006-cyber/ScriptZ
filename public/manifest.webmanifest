{
  "name": "ScriptZ",
  "short_name": "ScriptZ",
  "description": "Escribí guiones de cine, series, teatro, radio y cómic. Gratis.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f4f3ef",
