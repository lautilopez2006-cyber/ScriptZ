  "revision": 4,
  "blocks": [
    {
      "id": "b59e2d1c-33b3-426d-a7a5-a0dc2ad1327c",
      "kind": "scene",
      "text": "EXT. FARO - AMANECER"
    },
    {
      "id": "443532be-fb07-4116-a23a-90a754325f32",
      "kind": "action",
      "text": "El mar golpea los escalones del faro. MARA observa una luz intermitente."
    },
    {
      "id": "a9dbe58b-0ff5-4cfa-b1ed-7b502f132fa2",
      "kind": "character",
      "text": "MARA"
    },
    {
      "id": "88d3c71d-ae13-426c-8e36-1615e8006e82",
      "kind": "dialogue",
      "text": "La señal volvió a encenderse."
    },
    {
      "id": "dc683fb2-09bf-436b-9c7f-57094222b938",
      "kind": "scene",
      "text": "INT. FARO - MAÑANA"
    },
    {
      "id": "fab8e344-a950-4352-8b9e-5b75542b0822",
      "kind": "action",
      "text": "TOMÁS revisa una radio cubierta de polvo."
    },
    {
      "id": "b15ea5ce-5667-40ed-a0f6-918b205f7200",
      "kind": "character",
      "text": "TOMÁS"
    },
    {
      "id": "ecb5e196-c654-4cf7-b766-1ad5e13f46d3",
      "kind": "parenthetical",
      "text": "(sin levantar la vista)"
    },
    {
      "id": "4bde1e92-f8ed-4925-aee9-2ea7efaae7ea",
      "kind": "dialogue",
      "text": "Si seguimos esa frecuencia, encontraremos la respuesta."
    },
    {
      "id": "5f704de6-cbb5-41b7-9fd6-253569018f98",
      "kind": "scene",
      "text": "EXT. ACANTILADO - ATARDECER"
    },
    {
      "id": "df4ff3ce-5d84-49c2-8c59-8e8445ca79cf",
      "kind": "action",
      "text": "MARA y TOMÁS salen del faro. A lo lejos, una segunda luz responde."
    },
    {
      "id": "e974906e-6fdf-423b-b6ab-15b2b22fdcca",
      "kind": "transition",
      "text": "CORTE A:"
    }
  ],
