  "story": {
    "logline": "Dos jóvenes descubren que un faro abandonado todavía recibe señales de una costa desaparecida.",
    "synopsis": "Mara y Tomás investigan una frecuencia misteriosa y descubren que no están solos.",
    "theme": "La memoria sobrevive a la distancia.",
